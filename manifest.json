{
  "manifest_version": 3,
  "name": "Aura Lyrics \u2014 Custom TTML for Apple Music Web",
  "version": "2.0.0",
  "description": "Cinematic, word-synchronized TTML lyrics for Apple Music Web. Local library, customizable themes, fullscreen mode and sync offset.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://music.apple.com/*"
  ],
  "action": {
    "default_title": "Aura Lyrics",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.css"
      ],
      "matches": [
        "https://music.apple.com/*"
      ]
    }
  ]
}
